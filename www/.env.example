# Kopieer naar .env.local en vul in. NOOIT committen.

# Resend API-key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Waar leads naartoe gaan
CONTACT_TO=info@ment4l.nl

# Afzender — MOET een in Resend geverifieerd (sub)domein zijn.
# Advies: verzenddomein send.ment4l.nl, zodat de Google Workspace-mail (MX) ongemoeid blijft.
CONTACT_FROM="MENT4L website <formulier@send.ment4l.nl>"

# ── Google Ads conversiemeting ─────────────────────────────────────────
# Laat je deze leeg, dan laadt er geen Google-script, zet de site geen enkele
# cookie en verschijnt er geen toestemmingsbalk. Precies zoals de site nu is.
# Vul je hem in, dan komen de tag én de balk mee. Dat hoort samen: de balk
# bestaat alleen omdat de tag cookies zet.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# De conversielabels uit Google Ads: het stuk achter de schuine streep in
# AW-123456789/AbCdEfGhIj. Ontbreekt een label, dan wordt alleen het event in
# de dataLayer gezet en telt Ads de conversie nog niet. Je kunt de meting dus
# alvast aanzetten voordat de conversieacties in Ads bestaan.
NEXT_PUBLIC_GADS_LABEL_AANMELDING=
NEXT_PUBLIC_GADS_LABEL_TELEFOON=
NEXT_PUBLIC_GADS_LABEL_CONTACT=
